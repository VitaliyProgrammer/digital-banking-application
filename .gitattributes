# LF everywhere: in git and in the working copy, on every OS.
# This also overrides core.autocrlf, so Windows checkouts no longer convert files to CRLF.
* text=auto eol=lf

# Windows batch files are the only exception: cmd.exe needs CRLF.
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary files are never touched: a "fixed" line ending inside a font or an image corrupts it.
*.ttf binary
*.png binary
*.pdf binary
